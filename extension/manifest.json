{
  "manifest_version": 3,
  "name": "知行 · AI认知监督台",
  "short_name": "知行监督台",
  "version": "0.1.1",
  "version_name": "0.2.0-rc.1",
  "description": "在本地检查AI对话中的偏航、假设、重复与停止条件，生成可复制的纠偏指令。",
  "minimum_chrome_version": "114",
  "permissions": [
    "activeTab",
    "scripting",
    "sidePanel",
    "storage"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "打开知行 AI认知监督台",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
